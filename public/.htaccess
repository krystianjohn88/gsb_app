# Wymuszenie HTTPS: każde wejście przez http:// przekierowuje na https:// (ten sam adres).
# Drugi warunek chroni przed pętlą, gdy HTTPS kończy się na serwerze pośredniczącym (proxy).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
